# Optional desktop defaults. Copy to an ignored local environment file or set
# these values in the process environment; the application does not require a
# specific remote host.
OLLAMA_COWORK_OLLAMA_ORIGIN=http://127.0.0.1:11434
OLLAMA_COWORK_OLLAMA_MODEL=gemma4:12b

# Optional replaceable desktop runtime paths. Built host/tool executables are
# discovered beside the desktop executable; Node/opencode are discovered on
# PATH; the SRT bridge is discovered from the Spike 001 checkout. Uncomment an
# override only when the local layout differs.
# OLLAMA_COWORK_OPENCODE=C:\path\to\opencode.exe
# OLLAMA_COWORK_NODE=C:\path\to\node.exe
# OLLAMA_COWORK_BROKER_HOST=C:\path\to\ollama-cowork-broker-host.exe
# OLLAMA_COWORK_DOCX_TOOL=C:\path\to\ollama-cowork-docx-tool.exe
# OLLAMA_COWORK_SRT_BRIDGE=C:\path\to\srt-docx-bridge.mjs
# OLLAMA_COWORK_SRT_WIN=C:\path\to\srt-win.exe
# Use only a dedicated empty/app-owned directory; startup refuses unowned roots.
# OLLAMA_COWORK_RUNS_ROOT=C:\path\to\ollama-cowork-transient-runs

# Remote Spike 001 proofs require an explicit host to avoid silently targeting
# a developer's current machine or committing its private LAN address.
OLLAMA_COWORK_PROOF_OLLAMA_ORIGIN=http://ollama-host:11434
OLLAMA_COWORK_PROOF_OLLAMA_MODEL=gemma4:12b
