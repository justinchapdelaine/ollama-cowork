# Generated by Cargo
# will have compiled files and executables
debug
target

# Node / frontend build output
node_modules
dist
.vite
coverage
.nyc_output
.cache
.parcel-cache
.turbo
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
playwright-report/
test-results/

# Tauri generated schemas and build artifacts
src-tauri/gen
src-tauri/target

# Local/private planning notes that should not be committed
docs/local/

# Local agent/tool metadata
.agents/
.codex/

# Local environment and machine-specific overrides
.env
.env.*
!.env.example
*.local

# Local signing keys/certificates
*.key
*.pem
*.p12
*.pfx

# These are backup files generated by rustfmt
**/*.rs.bk

# Temp, patch, and merge leftovers
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
*~
*.swp
*.swo

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/
.vscode/

# Visual Studio / Windows tooling
.vs/
*.user
*.suo
*.sln.docstates
*.VC.db
*.VC.opendb

# Python helpers, if any local scripts are added later
__pycache__/
.pytest_cache/

# OS/editor noise
.DS_Store
Thumbs.db
