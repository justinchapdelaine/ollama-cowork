# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Local Codex/agent metadata
.agents/
.codex/

# Local-only project notes and working documents
docs/local/

# Node/Vite dependencies and generated frontend output
node_modules/
apps/desktop/dist/
apps/desktop/.vite/
*.tsbuildinfo
.npm/
.pnpm-store/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# Local package-manager and runtime logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Generated Tauri schemas (regenerated by the Tauri CLI)
apps/desktop/src-tauri/gen/

# Disposable Spike 001 generated document artifacts
tests/artifacts/
tests/fixtures/job-*.revised.docx

# Transient proof failure captures; sanitized evidence can be force-added when
# it is intentionally retained as part of a reviewed test record.
docs/test-plans/*-failure-logs/

# Local environment overrides and test coverage
.env
.env.*
!.env.example
coverage/
.nyc_output/

# Local credentials and private key containers
.npmrc
!.npmrc.example
.cargo/credentials
.cargo/credentials.toml
*.key
*.pfx
*.p12

# Disposable temporary files
*.tmp
*.temp

# Editor and operating-system metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
*.stackdump
$RECYCLE.BIN/
